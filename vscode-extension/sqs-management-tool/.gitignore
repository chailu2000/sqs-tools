# Gitignore for VS Code Extension

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
out/
.vscode-test/

# Test artifacts
test-results/
.test-workspace/

# Logs
*.log

# OS generated files
.DS_Store
.env
.vscode/*.code-workspace

# Local configuration
.vscode/*.json
.vscode/*.code-snippets

# pnpm-lock.yaml for pnpm
pnpm-lock.yaml