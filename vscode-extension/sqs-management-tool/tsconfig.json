{
  "compilerOptions": {
    "types": [
      "node",
      "vscode"
    ],
    "module": "commonjs",
    "target": "es2020",
    "outDir": "out",
    "lib": [
      "es2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "tests",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}