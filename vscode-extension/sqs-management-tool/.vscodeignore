PUBLISHING_MANUAL_STEPS.md
PUBLISHING_PREPARATION_SUMMARY.md

# Test files
docker-compose.test.yml
test-*.js
*.test.js
*.spec.js

# Logs and temporary files
*.log
*.tmp
.DS_Store
output.html

# Package manager files
pnpm-lock.yaml
package-lock.json
yarn.lock

# Source maps (not needed in production)
**/*.js.map

# Git
.git/**
.gitignore
.gitattributes

# CI/CD
.github/**

# Node modules (if using --no-dependencies)
node_modules/**

# Unused extension entry points (we only use extension-standalone.js)
out/extension.js
out/extension.js.map
out/extension-svelte.js
out/extension-svelte.js.map
out/api.js
out/api.js.map

# Keep these essential files
!README.md
!CHANGELOG.md
!LICENSE
