# Development files
.vscode/**
.vscode-test/**
src/**
tests/**
test-results/**
playwright-report/**
out/tests/**
*.test.ts
*.spec.ts
**/test/**
**/__tests__/**

# Build configuration
.gitignore
.eslintrc.json
.eslintrc.js
tsconfig.json
tsconfig.e2e.json
jest.config.js
jest.setup.js
.prettierrc
.prettierignore

# Scripts
scripts/**
*.sh
*.py

# Documentation (exclude development docs, keep user docs)
ARCHITECTURE.md
DEBUG_*.md
E2E_TEST_*.md
IMPLEMENTATION_*.md
STANDALONE_*.md
TASK_*.md
TESTING.md
TEST_STATUS.md
VERIFICATION_*.md
