{
    "all": true,
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/tests/**",
        "**/node_modules/**",
        "**/out/**",
        "**/dist/**",
        "**/*.d.ts"
    ],
    "reporter": [
        "html",
        "json",
        "lcov",
        "text",
        "text-summary"
    ],
    "reportDir": "coverage/e2e",
    "tempDirectory": ".nyc_output",
    "watermarks": {
        "lines": [
            65,
            70
        ],
        "functions": [
            65,
            70
        ],
        "branches": [
            60,
            65
        ],
        "statements": [
            65,
            70
        ]
    },
    "check-coverage": true,
    "lines": 70,
    "functions": 70,
    "branches": 65,
    "statements": 70
}