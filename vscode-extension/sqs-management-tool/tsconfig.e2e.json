{
    "compilerOptions": {
        "types": [
            "node",
            "mocha",
            "chai",
            "vscode"
        ],
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "out",
        "lib": [
            "ES2020"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "tests/e2e/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        "tests/unit",
        "src"
    ]
}